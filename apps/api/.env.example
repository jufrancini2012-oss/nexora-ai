// Asaas Production — configure como secrets no Worker, nunca no frontend
ASAAS_PRODUCTION_API_KEY=
ASAAS_PRODUCTION_WEBHOOK_TOKEN=

# Asaas Sandbox — nunca coloque estas chaves no frontend
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3

# Mercado Livre — fonte real de sinais de demanda
# Gere o token na aplicação do Mercado Livre e armazene como secret no ambiente do Worker.
MELI_ACCESS_TOKEN=
